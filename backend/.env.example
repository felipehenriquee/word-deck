# Variáveis lidas pelo docker-compose.yml (o compose carrega este arquivo como ".env"
# automaticamente). Para rodar localmente sem Docker, a configuração vem de
# src/Api/appsettings.Development.json — ou de variáveis de ambiente no formato
# Secao__Chave (ex: Jwt__Secret, ConnectionStrings__Default).

# Autenticação — HS256 exige no mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# CORS — uma ou mais origens separadas por vírgula (5173 = Vite/Vue/React, 4200 = Angular)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
